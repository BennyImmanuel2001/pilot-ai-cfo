# Copy to .env and fill in what you have. Every key is optional:
# anything missing falls back to a mock adapter and the UI shows a "demo data" badge.

# LLM: any OpenAI-compatible chat completions endpoint with tool calling
# (OpenRouter, Groq, Gemini's OpenAI-compatible endpoint, OpenAI, ...)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# PayPal. PAYPAL_MODE=simulate (the default) never sends anything to PayPal: approvals return
# simulated DEMO-* ids. Real sandbox calls are opt-in: set PAYPAL_MODE=sandbox AND the credentials.
# Note: the PayPal sandbox permanently retains catalog products, billing plans, subscriptions and
# captured payments. None of them can be deleted: plans can only be deactivated, subscriptions only
# cancelled, and unapproved orders expire after 3 hours. Pilot reuses one product + plan per
# (payee, amount, cadence) per server run, and only sends the amount and a short item/payee label
# (never transaction history, balances or user details).
PAYPAL_MODE=simulate
# Sandbox credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook id from `npm run paypal:webhooks -- create https://<public-host>/api/paypal/webhook`
# (or Developer Dashboard > your app > Webhooks). Deliveries are verified against it; without it,
# status updates come from polling PayPal instead.
PAYPAL_WEBHOOK_ID=
# Sandbox mode loads the account's last 31 days of transactions and its live balance on every start
# (needs "Transaction search" enabled on the app). Set false to keep only the seed data.
PAYPAL_SYNC_TRANSACTIONS=
# Where proposals, payments made in Pilot and the last sync are saved (default server/.data)
DATA_DIR=
# Simulate mode: delay before the simulated "buyer approved" webhook (ms)
PAYPAL_SIMULATED_APPROVAL_MS=3000

# Elastic (optional transaction store; API key optional for a local cluster without auth)
ELASTIC_URL=
ELASTIC_API_KEY=

# Channel3 (optional live product search)
CHANNEL3_API_KEY=

# Server
PORT=8787
# Where PayPal redirects after sandbox approval (the web app's URL)
APP_URL=http://localhost:5173

# Web (build time). Leave empty locally; Vite proxies /api to the server.
VITE_API_URL=
